{
  "name": "esh",
  "version": "2.0.0",
  "description": "Prose programming language interpreter with modern terminal UI",
  "main": "src/index.js",
  "bin": {
    "esh": "./src/index.js"
  },
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "repl": "node src/index.js --repl",
    "run": "node src/index.js --run",
    "build": "bun build --compile src/index.js --outfile dist/esh.exe",
    "test": "node --test test/test_*.js"
  },
  "keywords": [
    "prose",
    "language",
    "interpreter",
    "shell",
    "english-like"
  ],
  "license": "MIT",
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "figlet": "^1.11.2",
    "gradient-string": "^3.0.0",
    "ora": "^9.4.1"
  }
}
